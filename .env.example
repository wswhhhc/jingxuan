# 将本文件复制为 .env 后再填写本机值。本模板不得包含任何真实凭据。

SPRING_PROFILES_ACTIVE=dev

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jingxuan
DB_USER=jingxuan
DB_ROOT_PASSWORD=
# 仅在已有旧卷且本次同时轮换 root 密码时，临时填写旧 root 密码；迁移成功后可清空。
DB_LEGACY_ROOT_PASSWORD=
DB_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 本地文件存储目录
JINGXUAN_UPLOAD_PATH=./uploads

# 裸机 Nginx 的可信反向代理 CIDR。
JINGXUAN_SECURITY_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Docker Compose 使用固定 Nginx 地址，避免信任整个容器网段。
JINGXUAN_DOCKER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.31.250.2/32

# JWT：必须在本机生成足够长的随机值，不得使用模板值或提交到 Git。
JWT_EXPIRATION_MS=86400000
JWT_SECRET=

# DeepSeek：开发环境可留空并使用 bypass，生产环境必须显式配置。
DEEPSEEK_API_KEY=

# 邮件验证码
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
